# Replace the example hostname and certificate paths with operator-provided values.
# Set APP_ORIGIN to the resulting HTTPS origin and TRUST_PROXY=1 behind this proxy.
server {
    listen 80;
    server_name pilihanku.example.invalid;
    return 308 https://pilihanku.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    server_name pilihanku.example.invalid;
    ssl_certificate /etc/ssl/pilihanku/fullchain.pem;
    ssl_certificate_key /etc/ssl/pilihanku/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;
    gzip on;
    gzip_types text/css application/javascript application/json;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }
}
