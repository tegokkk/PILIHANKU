NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://pilihanku:CHANGE_ME@127.0.0.1:55432/pilihanku
TEST_DATABASE_URL=postgresql://pilihanku:CHANGE_ME@127.0.0.1:55432/pilihanku_test
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TRUST_PROXY=0
PENDING_RETENTION_DAYS=90
DEMO_CONTENT=false
# Bootstrap only; remove these after use. Never prefix secrets with VITE_.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TIMEZONE=Asia/Jakarta

BIND_HOST=127.0.0.1
# Optional structured request logging (enabled by default in production).
LOG_REQUESTS=false
# Worker production: absolute path on protected storage independent of backups.
DELETION_LEDGER_PATH=
# PostgreSQL client tools directory (pg_dump/pg_restore); keep keys outside source control.
PG_BIN=
BACKUP_KEY=
# Restore only into a separately created EMPTY database, never the active application DB.
RESTORE_DATABASE_URL=
