{
  "name": "pilihanku-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "knex migrate:latest --knexfile knexfile.cjs",
    "seed:demo": "node src/scripts/seed-demo.js",
    "bootstrap": "node src/scripts/bootstrap-superadmin.js",
    "db:local": "node src/scripts/local-postgres.js",
    "retention": "node src/jobs/retention.js",
    "worker": "node src/scripts/retention-worker.js",
    "backup": "node src/scripts/backup.js",
    "restore": "node src/scripts/restore.js",
    "test:load": "node src/scripts/measure-pilot.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "connect-pg-simple": "10.0.0",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "embedded-postgres": "18.7.0-beta.19",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supertest": "7.3.2"
  }
}
